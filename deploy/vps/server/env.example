# Copy to /opt/postiz/.env on the server and fill it in (chmod 600).
# Every value here reaches the Postiz container; backup credentials go in
# backup.env instead.
# Keep a copy in your password manager: losing it means new DB passwords and
# re-entering every social app key.
#
# Generate each password/secret with:  openssl rand -hex 32
# (hex only, so the values are safe inside DATABASE_URL)

# === Deploy settings (used by docker-compose.yml and the scripts)
POSTIZ_DOMAIN=postiz.beyondhimalayatech.com.au
# Written by deploy.sh on every deploy, leave as is
POSTIZ_TAG=none

# === Databases
POSTGRES_USER=postiz
POSTGRES_PASSWORD=
POSTGRES_DB=postiz
TEMPORAL_DB_USER=temporal
TEMPORAL_DB_PASSWORD=

# === Postiz
JWT_SECRET=
# Leave false until the first account (the owner) has signed up, then set it
# to true and run `docker compose up -d postiz`. Teammates join by invite.
DISABLE_REGISTRATION=false
API_LIMIT=30

# Optional: without it, accounts are activated without an email
#RESEND_API_KEY=
#EMAIL_FROM_ADDRESS=
#EMAIL_FROM_NAME=

#OPENAI_API_KEY=

# === Social networks: add the ones you connect.
# The full list of keys is in the repo's root .env.example.
# Callback URLs are https://<POSTIZ_DOMAIN>/integrations/social/<provider>
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
X_API_KEY=
X_API_SECRET=
