# Copy to /opt/postiz/backup.env on the server and fill it in (chmod 600).
# Used only by backup.sh and restore.sh, never passed to the containers.
# Fill in the section for your provider (see README).

# s3 (AWS) or r2 (Cloudflare)
BACKUP_PROVIDER=s3
BACKUP_BUCKET=
BACKUP_ACCESS_KEY_ID=
BACKUP_SECRET_ACCESS_KEY=

# AWS S3 only
S3_REGION=ap-southeast-2

# Cloudflare R2 only
#R2_ACCOUNT_ID=
